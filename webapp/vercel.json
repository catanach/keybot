{
  "buildCommand": "pip install -r requirements.txt",
  "framework": "python",
  "python": {
    "version": "3.12"
  },
  "functions": {
    "api/index.py": {
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "env": {
    "KEYBOT_DATA_DIR": "/tmp/keybot_data"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
